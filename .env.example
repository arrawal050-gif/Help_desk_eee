# ── Environment Variables & API Key Placeholders ─────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
# For Vercel deployment:
#   Set these environment variables under Project Settings > Environment Variables

# Server & Deployment URL
HOST=0.0.0.0
PORT=8000
API_BASE_URL=https://your-vercel-domain.vercel.app

# Optional AI / External Service Keys (Add if integrating third-party APIs)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Microsoft Edge-TTS Configuration (Optional overrides)
TTS_VOICE=hi-IN-SwaraNeural
TTS_PITCH=+18Hz
TTS_RATE=+10%
